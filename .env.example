# Copy to .env and supply local secrets; never commit the populated file.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=delhivery_ai
DB_USER=
DB_PASSWORD=
# Optional: mysql+pymysql://user:password@host:3306/database
# DATABASE_URL=
# Optional; the application falls back to in-process execution when absent/unreachable.
# REDIS_URL=redis://localhost:6379/0
# EMBEDDING_DEVICE=auto
# EMBEDDING_BATCH_SIZE=32
